import("//third_party/winwrap/winwrap.gni")

assert(is_win || target_os == "win", "winwrap is only valid for Windows targets")

config("winwrap_public_config") {
  # src/public and not src, so a consumer sees winwrap_public.h and nothing
  # else. That is the whole public surface: the ww_* shims in winwrap.h are
  # reached through the import table rather than by name -- a consumer never
  # writes ww_GetTickCount64, it writes GetTickCount64 and winwrap owns the
  # __imp_ slot behind it -- so putting that header on their include path
  # would only offer names nobody should be calling.
  #
  # Narrowing this is a breaking change for anyone who was including
  # winwrap.h, and that is deliberate. A winwrap.h that cannot be found from
  # outside means the boundary is working, not that the include path is
  # wrong.
  include_dirs = [ "src/public" ]

  # Universal define so consumers know they are including winwrap.
  defines = [ "USING_WINWRAP" ]

  if (is_component_winwrap) {
    # So consumers can easily tell if they are built against the shared lib.
    defines += [ "WINWRAP_DLL" ]
  }
}

# Depend on this rather than on ":winwrap" directly, so a build with
# use_winwrap = false links nothing at all and the dependency can stay
# unconditional at the call site.
group("winwrap_lib") {
  if (use_winwrap) {
    if (is_component_winwrap) {
      public_deps = [ "src:winwrap_shared" ]
    } else {
      public_deps = [ "src:winwrap_static" ]
    }
  }
}

group("winwrap_all") {
  testonly = true

  # Build both static and shared versions of the lib
  deps = [
    "src:winwrap_shared",
    "src:winwrap_static",
  ]

  # Forward test configs to dependants.
  public_deps = [ "test:winwrap_tests" ]
}
