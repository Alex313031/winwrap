# Stress tests winwrap library functions

import("//third_party/winwrap/winwrap.gni")

group("winwrap_tests") {
  testonly = true

  public_deps = [ ":winwrap_unit_test" ]
}

executable("winwrap_unit_test") {
  configs += [
    ":winwrap_unit_test_config",
    "../:winwrap_public_config",
  ]

  sources = [
    "winwrap_unittest.cc",
    "winwrap_unittest.h",
  ]

  deps = [ "../:winwrap_lib" ]

  output_name = "winwrap_test"

  # No /SUBSYSTEM ldflags here. //build/config/win:console already appends the
  # minimum OS version, and in a tree carrying electron-legacy's patch series
  # that is 5.01 on x86 and 5.02 on x64 -- the reverted
  # "set subsystem version to 10.0 across the board" puts it back. Outside such
  # a tree this will link against whatever the host Chromium uses, and will
  # need the flag.
}

config("winwrap_unit_test_config") {
  # WINWRAP_TEST marks the translation unit as the test. Nothing reads it yet;
  # every build system defines it so that something can. UNICODE as on the
  # library: the sources define it themselves if nobody has, so this is
  # agreement with the other builds rather than behaviour.
  defines = [
    "WINWRAP_TEST",
    "UNICODE",
    "_UNICODE",
  ]

  # Which form the test was linked against, as $(FORMDEF) tells it in the
  # makefiles. WINWRAP_DLL arrives with winwrap_public_config when the shared
  # form is selected; nothing supplies the static half, which is read nowhere
  # and is set so that the builds agree.
  if (!is_component_winwrap) {
    defines += [ "WINWRAP_STATIC" ]
  }

  # ../src for winwrap.h, which this includes with angle brackets, and
  # ../src/public for winwrap_public.h. The second is what a consumer gets on
  # its own include path, and spelling it the same way here is deliberate: it
  # means the test would stop compiling if that header moved out from under
  # the public surface.
  #
  # Deliberately not winwrap_private_config, which would also bring that
  # config's -D_WIN32_WINNT=0x0501 and -DNTDDI_VERSION=0x05010300. Those
  # exist to keep winwrap's own sources from seeing post-XP declarations, and
  # this file needs the opposite: it builds against the current SDK so that it
  # can call the Win32 names it is testing. evntprov.h is the one that would
  # fail first -- EventWriteTransfer is gated above XP and would simply vanish.
  #
  # This matches what the Makefile does for the same translation unit: /I src
  # /I src\public /I test, and none of the version flags from CXXFLAGS.
  include_dirs = [
    ".",
    "../src",
    "../src/public",
  ]
}
