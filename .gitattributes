# Set default behavior to automatically normalize line endings.
* text=auto
*.c text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cc text eol=lf
*.cxx text eol=lf
*.cpp text eol=lf
*.idl text eol=lf
*.def text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf

# Build system Files
*.py text eol=lf
*.gn text eol=lf
*.gni text eol=lf
*.mak text eol=lf

# Keep scripts correct
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.rc text eol=crlf

# Patches must stay byte-exact: some intentionally contain CRLF lines
# (they patch CRLF files in the Chromium tree), so never convert them.
*.diff -text
*.patch -text
