; Shared-library mode: export the public Win32 names, aliased onto the
; winwrap_ implementations, so the generated import library provides
; __imp_<name> and the linker binds there instead of kernel32.
;
; Undecorated alias targets work on both architectures: lld-link matches
; ww_GetTickCount64 against the decorated _ww_GetTickCount64@0 that
; __stdcall actually emits. Confirmed on x86 -- the 32-bit winwrap.dll exports
; every name below, and electron.exe binds GetTickCount64, InitOnceExecuteOnce
; and the SRWLOCK family to winwrap.dll with no remaining kernel32 import for
; any of them.
;
; Sorted by exported name. The last two are winwrap's own API rather than
; stand-ins for a Win32 function, so they are exported under their own names
; with nothing to alias.
LIBRARY winwrap
EXPORTS
    AcquireSRWLockExclusive = ww_AcquireSRWLockExclusive
    AcquireSRWLockShared = ww_AcquireSRWLockShared
    CancelIoEx = ww_CancelIoEx
    CancelSynchronousIo = ww_CancelSynchronousIo
    CompareStringOrdinal = ww_CompareStringOrdinal
    ConvertThreadToFiberEx = ww_ConvertThreadToFiberEx
    CreateFiberEx = ww_CreateFiberEx
    CreateSymbolicLinkW = ww_CreateSymbolicLinkW
    DllGetVersion
    FlsAlloc = ww_FlsAlloc
    FlsFree = ww_FlsFree
    FlsGetValue = ww_FlsGetValue
    FlsSetValue = ww_FlsSetValue
    GetCurrentProcessExplicitAppUserModelID = ww_GetCurrentProcessExplicitAppUserModelID
    GetCurrentProcessorNumber = ww_GetCurrentProcessorNumber
    GetErrorMode = ww_GetErrorMode
    GetFileInformationByHandleEx = ww_GetFileInformationByHandleEx
    GetFinalPathNameByHandleW = ww_GetFinalPathNameByHandleW
    GetLocaleInfoEx = ww_GetLocaleInfoEx
    GetNamedPipeClientProcessId = ww_GetNamedPipeClientProcessId
    GetNamedPipeServerProcessId = ww_GetNamedPipeServerProcessId
    GetQueuedCompletionStatusEx = ww_GetQueuedCompletionStatusEx
    GetRealNTVersion
    GetTickCount64 = ww_GetTickCount64
    InitializeConditionVariable = ww_InitializeConditionVariable
    InitializeCriticalSectionEx = ww_InitializeCriticalSectionEx
    InitializeSRWLock = ww_InitializeSRWLock
    InitOnceExecuteOnce = ww_InitOnceExecuteOnce
    IsRunningOnWine
    IsThreadAFiber = ww_IsThreadAFiber
    NeedCurrentDirectoryForExePathW = ww_NeedCurrentDirectoryForExePathW
    RegGetValueW = ww_RegGetValueW
    RegisterApplicationRestart = ww_RegisterApplicationRestart
    ReleaseSRWLockExclusive = ww_ReleaseSRWLockExclusive
    ReleaseSRWLockShared = ww_ReleaseSRWLockShared
    ReOpenFile = ww_ReOpenFile
    SetCurrentProcessExplicitAppUserModelID = ww_SetCurrentProcessExplicitAppUserModelID
    SetFileCompletionNotificationModes = ww_SetFileCompletionNotificationModes
    SetFileInformationByHandle = ww_SetFileInformationByHandle
    SetProcessDPIAware = ww_SetProcessDPIAware
    SleepConditionVariableCS = ww_SleepConditionVariableCS
    SleepConditionVariableSRW = ww_SleepConditionVariableSRW
    TryAcquireSRWLockExclusive = ww_TryAcquireSRWLockExclusive
    TryAcquireSRWLockShared = ww_TryAcquireSRWLockShared
    UnregisterApplicationRestart = ww_UnregisterApplicationRestart
    WakeAllConditionVariable = ww_WakeAllConditionVariable
    WakeConditionVariable = ww_WakeConditionVariable
